# --- Telegram ---
# Токен от @BotFather
BOT_TOKEN=
# Telegram ID администраторов через запятую (узнать свой: @userinfobot)
ADMIN_IDS=

# --- Прокси ---
# ОСТАВЬТЕ ПУСТЫМ: бот сам определяет, как выходить в сеть — напрямую,
# через системный прокси Windows или через локальный прокси VPN-клиента
# (Happ, v2rayN, Nekoray, Hiddify, Clash). Заполняйте, только если хотите
# задать конкретный адрес: socks5://127.0.0.1:2080 или http://user:pass@host:3128
TELEGRAM_PROXY=
AI_PROXY=

# --- AnyModel (OpenAI-совместимый API) ---
AI_BASE_URL=https://anymodel.org/v1
AI_API_KEY=
AI_MODEL=cx/gpt-5.6-sol
# Модель эмбеддингов. У AnyModel их НЕТ — оставьте пустым.
# Смысловой поиск вместо них делает переспрос (см. ниже).
AI_EMBEDDING_MODEL=

# Системный промпт для ИИ
AI_SYSTEM_PROMPT=Ты — справочный ассистент. Отвечай кратко, по делу, на русском языке. Если не знаешь ответа — прямо скажи об этом, не выдумывай.

# --- Логика поиска ---
DB_PATH=knowledge.db
# Порог уверенности: выше — отвечаем из базы, ниже — идём в ИИ (0..1)
MATCH_THRESHOLD=0.55
# Сколько записей из базы подмешивать в контекст ИИ
CONTEXT_TOP_K=3
# Сохранять ответы ИИ в базу автоматически
AUTOSAVE_AI=true

# --- Переспрос: смысловой поиск без эмбеддингов ---
# Если лучший результат ниже MATCH_THRESHOLD, но выше RERANK_MIN_SCORE,
# бот показывает 3 кандидата дешёвой модели и спрашивает, отвечает ли
# какой-нибудь из них. Так находятся синонимы: «вернуть покупку» ->
# «как вернуть товар», «телефон поддержки» -> «как связаться с поддержкой».
AI_RERANK=true
AI_RERANK_MODEL=ag/gemini-3.7-flash-low
# Ниже этого скора не переспрашиваем — запрос точно про другое
RERANK_MIN_SCORE=0.25

# --- Режим консультанта по прайсу ---
# Включите, если бот отвечает по прайсу услуг (детейлинг, салон, клиника).
# Что меняется:
#   • модели уходит ВЕСЬ каталог — она складывает услуги и подбирает цену
#     по классу авто, а не выдаёт одну найденную запись;
#   • модели запрещено называть цены и услуги, которых в каталоге нет;
#   • ответы ИИ НЕ сохраняются в базу (иначе выдумка станет вашим прайсом).
STRICT_CATALOG=false
# Обязательно при STRICT_CATALOG: автосейв ответов ИИ выключить
# AUTOSAVE_AI=false
# Куда отправлять клиента, когда в прайсе ответа нет
FALLBACK_CONTACT=
# Одна строка о компании — чтобы бот понимал предметную область
BUSINESS_INFO=
# Сколько записей прайса влезает в контекст (больше — дороже запрос)
CATALOG_MAX_ROWS=200
# Насколько точным должно быть совпадение, чтобы ответить из базы без ИИ.
# Высокое значение = чаще подключаем модель = точнее ответ, но дороже.
STRICT_DIRECT_MIN=0.90

# --- Экономия токенов ---
# Вопрос, ни одно слово которого не встречается в прайсе, до модели не
# доходит: «сколько стоит шаурма» стоил бы столько же, сколько вопрос про
# керамику — весь каталог уходит в контекст на каждый запрос.
TOPIC_GUARD=true
OFFTOPIC_REPLY=Я подсказываю только по услугам и ценам нашей студии. Спросите про мойку, химчистку, полировку, керамику, оклейку плёнкой, шумоизоляцию или тонировку — отвечу по прайсу.

# Слова, которые всегда считаются «по теме», через запятую.
# Адрес, часы, запись, оплата, гарантия уже учтены.
EXTRA_TOPIC_WORDS=

# Обращений к ИИ на человека в час (0 — без лимита). Админов не касается.
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_REPLY=Слишком много вопросов подряд — сделаем паузу. Напишите чуть позже или свяжитесь с менеджером напрямую.

# --- Запись на осмотр (захват лидов) ---
# После ответа с ценой бот предлагает записаться, собирает имя, телефон,
# машину и удобное время, а карточку заявки шлёт владельцу студии.
LEAD_CAPTURE=true
# Куда слать заявки: id чата студии. Пусто — шлём всем из ADMIN_IDS.
# Узнать id группы: добавьте в неё @userinfobot
LEAD_CHAT_ID=
LEAD_BUTTON=📝 Записаться на осмотр
LEAD_DONE=Записал! Менеджер свяжется с вами, чтобы подтвердить время.

# --- Дожим и напоминания ---
# Фоновая задача догоняет тех, кто спросил цену и не записался, и напоминает
# владельцу о заявках, которые никто не взял в работу.
FOLLOWUP_ENABLED=true
FOLLOWUP_EVERY_MIN=15

# Через сколько часов после разговора написать тому, кто не записался.
# Пишем ОДИН раз.
NUDGE_AFTER_HOURS=3
# И только если разговор был не давнее этого — иначе выглядит спамом
NUDGE_WINDOW_HOURS=48
NUDGE_TEXT=Остались вопросы по услугам? Могу записать на осмотр — мастер посмотрит машину и назовёт точную цену.

# Заявку не взяли в работу столько минут — напомнить владельцу
LEAD_REMIND_AFTER_MIN=120

# Тихие часы по местному времени: ночью людям не пишем.
# Одинаковые значения = круглосуточно.
QUIET_FROM_HOUR=21
QUIET_TO_HOUR=10
TIMEZONE_OFFSET=3

# --- Голосовые и кружки ---
# Голосовое расшифровывается и идёт как обычный вопрос. Тихая запись до
# модели не доходит (она на тишине выдумывает слова) — проверяет voice.py.
VOICE_TRANSCRIBE=true
# Модель с приёмом аудио — из доступных это Gemini. flash-low точная (~4 с),
# 2.5-flash-lite быстрее, но путает слова
AI_VOICE_MODEL=ag/gemini-3.7-flash-low
# Длиннее — просим написать текстом
VOICE_MAX_SEC=90
# Тексты (необязательно, есть значения по умолчанию):
# VOICE_UNCLEAR=Не разобрал голосовое — напишите, пожалуйста, текстом.
# VOICE_TOO_LONG=Голосовое слишком длинное. Напишите, пожалуйста, коротко текстом.
# VOICE_ECHO=🎤 Вы сказали: «{text}»

# --- Нетекстовые сообщения ---
# На фото, видео, стикер, файл бот отвечает подсказкой и кнопкой записи.
# Подпись к фото считается обычным вопросом. Тексты правятся здесь:
# MEDIA_PHOTO=Фото получил. Точную цену по фотографии не назову…
# MEDIA_VIDEO=Видео получил, но оценить по нему не смогу…
# MEDIA_STICKER=Напишите вопрос текстом — подскажу по услугам и ценам.
# MEDIA_FILE=Файлы я не читаю. Напишите вопрос текстом — отвечу по прайсу.
# UNKNOWN_COMMAND=Такой команды у меня нет. Просто напишите вопрос словами — или отправьте /help

# --- Отчёт владельцу ---
# Раз в неделю сводка уходит в чат студии (LEAD_CHAT_ID, иначе админам):
# сколько написали, сколько записались, о чём спрашивали, чего нет в прайсе.
# Вручную: /report, /report 30, /report 7 send
REPORT_WEEKLY=true
REPORT_WEEKDAY=0
REPORT_HOUR=10

# --- Студия и пробный период ---
# Имя студии в приветствии: «Я помощник студии Detailing Pro»
STUDIO_NAME=
# Дата окончания пробного периода, ГГГГ-ММ-ДД. Пусто — без ограничения.
# За 3 и за 1 день бот напоминает админам, в день окончания шлёт владельцу
# итоги и перестаёт отвечать клиентам. Продлить без правки файла: /trial +7
TRIAL_UNTIL=
TRIAL_WARN_DAYS=3,1
# TRIAL_OVER_TEXT=Бот временно не принимает вопросы. Свяжитесь со студией напрямую.

# Демо-режим: /demo доступна всем и за минуту показывает возможности бота.
# Только на демо-боте, у ботов студий — false.
DEMO_MODE=false

# --- Тариф ---
# standard — ответы, запись, заявки, дожим, отчёт по понедельникам.
# pro — плюс рассылки по базе (/broadcast), ежедневная сводка, несколько
# чатов для заявок (LEAD_CHAT_ID через запятую), передача заявок в CRM.
PLAN=standard
# Про: JSON каждой заявки POST-ом на этот адрес (вебхук Bitrix24, Albato и т.п.)
CRM_WEBHOOK_URL=
# Про: рассылки — кому (писали за N дней) и как часто одному человеку
BROADCAST_DAYS=60
BROADCAST_COOLDOWN_DAYS=14
REPORT_DAILY=true
